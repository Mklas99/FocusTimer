<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Avalonia.Win32</AssemblyName>
    <PackageId>Avalonia.Win32</PackageId>
    <Version>11.2.0.5-focustimer.5</Version>
    <AssemblyVersion>11.2.0.0</AssemblyVersion>
    <FileVersion>11.2.0.5</FileVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <Deterministic>true</Deterministic>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../..'))=/_/Avalonia</PathMap>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableRuntimeMarshalling>true</EnableRuntimeMarshalling>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>../../../build/avalonia.snk</AssemblyOriginatorKeyFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/AvaloniaUI/Avalonia</PackageProjectUrl>
    <Description>FocusTimer prototype extension of Avalonia 11.2.0 Windows backdrop control.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Upstream's facade reference assemblies forbid backend implementation. Use pinned runtime metadata. -->
    <PackageReference Include="Avalonia" Version="[11.2.0]" GeneratePathProperty="true" ExcludeAssets="compile" />
    <Reference Include="Avalonia.Base" HintPath="$(PkgAvalonia)/lib/net8.0/Avalonia.Base.dll" Private="false" />
    <Reference Include="Avalonia.Controls" HintPath="$(PkgAvalonia)/lib/net8.0/Avalonia.Controls.dll" Private="false" />
    <Reference Include="Avalonia.OpenGL" HintPath="$(PkgAvalonia)/lib/net8.0/Avalonia.OpenGL.dll" Private="false" />
    <Reference Include="Avalonia.MicroCom" HintPath="$(PkgAvalonia)/lib/net8.0/Avalonia.MicroCom.dll" Private="false" />
    <Reference Include="Avalonia.Vulkan" HintPath="$(PkgAvalonia)/lib/net8.0/Avalonia.Vulkan.dll" Private="false" />
    <PackageReference Include="Avalonia.Angle.Windows.Natives" Version="2.1.22045.20230930" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106" PrivateAssets="all" />
    <PackageReference Include="MicroCom.CodeGenerator.MSBuild" Version="0.11.0" PrivateAssets="all" />
    <PackageReference Include="MicroCom.Runtime" Version="0.11.0" />
    <Compile Remove="WinRT/WinRT.Generated.cs;Win32Com/Win32.Generated.cs;DirectX/directx.Generated.cs;DComposition/DComp.Generated.cs" />
    <MicroComIdl Include="WinRT/winrt.idl" CSharpInteropPath="WinRT/WinRT.Generated.cs" />
    <MicroComIdl Include="Win32Com/win32.idl" CSharpInteropPath="Win32Com/Win32.Generated.cs" />
    <MicroComIdl Include="DirectX/directx.idl" CSharpInteropPath="DirectX/directx.Generated.cs" />
    <MicroComIdl Include="DComposition/dcomp.idl" CSharpInteropPath="DComposition/DComp.Generated.cs" />
  </ItemGroup>
  <Import Project="../../../build/SourceGenerators.props" />
  <ItemGroup>
    <Compile Remove="$(MSBuildProjectDirectory)/../../../build/../src/Shared/SourceGeneratorAttributes.cs" />
    <None Include="../../../licence.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
