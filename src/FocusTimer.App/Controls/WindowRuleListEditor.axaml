<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FocusTimer.App.ViewModels"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             x:Class="FocusTimer.App.Controls.WindowRuleListEditor"
             x:DataType="vm:WindowRuleListViewModel">
    <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal">
            <TextBlock Classes="SettingLabel" FontWeight="SemiBold" Text="{Binding Title}" />
            <Border Classes="help-hint" ToolTip.Tip="{Binding Description}" Focusable="True"
                    AutomationProperties.Name="About these rules" AutomationProperties.HelpText="{Binding Description}">
                <icons:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16" Foreground="{DynamicResource SettingsLabelTextBrush}" />
            </Border>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Rules}" x:Name="RuleList" Margin="12,0,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WindowRuleItemViewModel">
                    <Border Classes="rule-row" Classes.warning="{Binding HasWarning}" Classes.danger="{Binding HasError}" Margin="0,0,0,8">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                    <StackPanel Spacing="2" Margin="0,0,8,6">
                                        <TextBlock Classes="helper-text" Text="Application pattern" />
                                        <TextBox Width="150" Text="{Binding AppPattern}" Watermark="e.g. keepass" AutomationProperties.Name="Application pattern" />
                                    </StackPanel>
                                    <StackPanel Spacing="2" Margin="0,0,8,6">
                                        <TextBlock Classes="helper-text" Text="Window title pattern" />
                                        <TextBox Width="150" Text="{Binding TitlePattern}" Watermark="e.g. *bank*" AutomationProperties.Name="Window title pattern" />
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top" Margin="8,18,0,0">
                                    <Button Classes="rule-action" Content="Up" AutomationProperties.Name="Move rule up" Command="{Binding #RuleList.((vm:WindowRuleListViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}" />
                                    <Button Classes="rule-action" Content="Down" AutomationProperties.Name="Move rule down" Command="{Binding #RuleList.((vm:WindowRuleListViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}" />
                                    <Button Classes="rule-action" Content="Remove" AutomationProperties.Name="Remove rule" Command="{Binding #RuleList.((vm:WindowRuleListViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Classes="helper-text rule-warning" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" />
                            <TextBlock Classes="helper-text rule-error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Add rule" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="12,0,0,0" />
    </StackPanel>
</UserControl>
