<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="using:FocusTimer.App.ViewModels"
        xmlns:views="using:FocusTimer.App.Views"
        xmlns:controls="using:FocusTimer.App.Controls"
        x:Class="FocusTimer.App.Views.WorklogWindow"
        x:DataType="vm:WorklogWindowViewModel"
        Classes="settings-window"
        Title="FocusTimer – Worklog"
        Width="900" Height="620"
        MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        Foreground="{DynamicResource DesktopTextBrush}">

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,*" Margin="{DynamicResource DesktopContentPadding}">

        <!-- Day selector: one day at a time for every tab -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,0,0,12">
            <Button Grid.Column="0"
                    Classes="icon-tool"
                    Command="{Binding PreviousDayCommand}"
                    IsEnabled="{Binding CanSelectPrevious}"
                    AutomationProperties.Name="Previous day"
                    ToolTip.Tip="Previous day">
                <icons:MaterialIcon Kind="ChevronLeft" Width="18" Height="18" />
            </Button>
            <CalendarDatePicker Grid.Column="1"
                                Margin="{StaticResource SpacingThicknessXs}"
                                Background="Transparent"
                                SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                DisplayDateStart="{Binding DisplayDateStart}"
                                DisplayDateEnd="{Binding DisplayDateEnd}"
                                AutomationProperties.Name="Selected day" />
            <Button Grid.Column="2"
                    Classes="icon-tool"
                    Command="{Binding NextDayCommand}"
                    IsEnabled="{Binding CanSelectNext}"
                    AutomationProperties.Name="Next day"
                    ToolTip.Tip="Next day">
                <icons:MaterialIcon Kind="ChevronRight" Width="18" Height="18" />
            </Button>
            <Button Grid.Column="3"
                    Content="Today"
                    Margin="{StaticResource SpacingThicknessSm}"
                    Command="{Binding TodayCommand}"
                    AutomationProperties.Name="Go to today" />
            <TextBlock Grid.Column="4"
                       Classes="page-title"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding SelectedDayText}" />

            <!-- Reloads the shown tab (F5); the same place on every tab -->
            <Button Grid.Column="5"
                    Classes="icon-tool"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="Refresh"
                    ToolTip.Tip="Reload this tab (F5)">
                <icons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
            </Button>
        </Grid>

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DesktopWarningBrush}"
                   Text="{Binding DayMessage}"
                   IsVisible="{Binding HasDayMessage}" />

        <TabControl x:Name="Tabs" Grid.Row="2" SelectionChanged="OnTabSelectionChanged">
            <TabItem Tag="Entries" AutomationProperties.Name="Entries">
                <TabItem.Header>
                    <controls:TabHeader Icon="ViewListOutline" Text="Entries" />
                </TabItem.Header>
                <views:WorklogEntriesView Margin="12,12,12,0" DataContext="{Binding Entries}" />
            </TabItem>
            <TabItem Tag="Timeline" AutomationProperties.Name="Timeline">
                <TabItem.Header>
                    <controls:TabHeader Icon="ChartTimelineVariant" Text="Timeline" />
                </TabItem.Header>
                <views:WorklogTimelineView Margin="12,12,12,0" DataContext="{Binding Timeline}" />
            </TabItem>
            <TabItem Tag="Summary" AutomationProperties.Name="Summary">
                <TabItem.Header>
                    <controls:TabHeader Icon="ChartBoxOutline" Text="Summary" />
                </TabItem.Header>
                <views:WorklogSummaryView Margin="12,12,12,0" DataContext="{Binding Summary}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
