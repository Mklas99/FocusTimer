<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FocusTimer.App.ViewModels"
             xmlns:controls="using:FocusTimer.App.Controls"
             x:DataType="vm:WorklogTimelineViewModel"
             x:Class="FocusTimer.App.Views.WorklogTimelineView">

    <UserControl.Styles>
        <!-- Tracked entries are solid; manual entries have a dashed outline and a "Manual" label, so the
             difference never depends on color alone. -->
        <Style Selector="Border.timeline-block">
            <Setter Property="Background" Value="{DynamicResource TabSelectedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.timeline-block.timeline-manual">
            <Setter Property="Background" Value="{DynamicResource SettingsBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.timeline-block TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TabSelectedTextBrush}" />
        </Style>
        <Style Selector="Border.timeline-block.timeline-manual TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style Selector="Border.timeline-hour">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Zoom: Ctrl + mouse wheel works too (Ctrl + plus, Ctrl + minus, Ctrl + 0 on the keyboard) -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpacingSm}"
                    Margin="0,0,0,8">
            <TextBlock Classes="SettingLabel" Text="Zoom" VerticalAlignment="Center" />
            <Button Content="&#8722;"
                    MinWidth="{StaticResource MinHitTargetSize}"
                    MinHeight="{StaticResource MinHitTargetSize}"
                    Command="{Binding ZoomOutCommand}"
                    IsEnabled="{Binding CanZoomOut}"
                    AutomationProperties.Name="Zoom out"
                    ToolTip.Tip="Zoom out (Ctrl + minus)" />
            <TextBlock Text="{Binding ZoomText}"
                       MinWidth="48"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Current zoom" />
            <Button Content="+"
                    MinWidth="{StaticResource MinHitTargetSize}"
                    MinHeight="{StaticResource MinHitTargetSize}"
                    Command="{Binding ZoomInCommand}"
                    IsEnabled="{Binding CanZoomIn}"
                    AutomationProperties.Name="Zoom in"
                    ToolTip.Tip="Zoom in (Ctrl + plus)" />
            <Button Content="Reset"
                    MinHeight="{StaticResource MinHitTargetSize}"
                    Command="{Binding ResetZoomCommand}"
                    AutomationProperties.Name="Reset zoom"
                    ToolTip.Tip="Back to 100% (Ctrl + 0)" />
            <TextBlock Text="Ctrl + mouse wheel zooms the hours"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="{StaticResource FontSizeCaption}" />
        </StackPanel>

        <!-- Read states and warnings are the same as on the Entries tab -->
        <StackPanel Grid.Row="1" Spacing="{StaticResource SpacingSm}">
            <TextBlock Text="{Binding Entries.WarningText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource WarningBrush}"
                       IsVisible="{Binding Entries.HasWarning}" />
            <TextBlock Text="Loading…"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       IsVisible="{Binding Entries.IsLoading}" />
            <TextBlock Text="{Binding Entries.StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       IsVisible="{Binding Entries.IsMessageVisible}" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller"
                      Grid.Row="2"
                      Classes="settings-scroll"
                      Focusable="True"
                      IsVisible="{Binding HasBlocks}"
                      AutomationProperties.Name="Timeline of the day">
            <Grid ColumnDefinitions="48,*" Height="{Binding AxisHeight}">
                <!-- Hour grid and labels: 24 equal rows that follow the zoom -->
                <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding HourLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" Rows="24" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Classes="timeline-hour">
                                <TextBlock Text="{Binding}"
                                           FontFamily="{StaticResource TabularTimerFontFamily}"
                                           FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Top"
                                           Margin="0,2,0,0" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Entries as blocks; overlapping entries share the width -->
                <ItemsControl Grid.Column="1" Margin="0,0,16,0" ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:TimelinePanel HourHeight="{Binding $parent[UserControl].((vm:WorklogTimelineViewModel)DataContext).HourHeight}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TimelineBlockViewModel">
                            <Border Classes="timeline-block"
                                    Classes.timeline-manual="{Binding IsManual}"
                                    ToolTip.Tip="{Binding ToolTipText}"
                                    AutomationProperties.Name="{Binding ToolTipText}">
                                <StackPanel>
                                    <TextBlock Text="{Binding TimeText}"
                                               FontFamily="{StaticResource TabularTimerFontFamily}"
                                               FontSize="{StaticResource FontSizeCaption}" />
                                    <TextBlock Text="{Binding TitleText}"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DetailText}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{StaticResource FontSizeCaption}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
