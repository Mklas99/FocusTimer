<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FocusTimer.App.ViewModels"
             x:DataType="vm:WorklogSummaryViewModel"
             x:Class="FocusTimer.App.Views.WorklogSummaryView">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Total of the day shown above the tabs -->
        <StackPanel Grid.Row="0" Spacing="{StaticResource SpacingXs}" Margin="0,0,0,12" IsVisible="{Binding IsReady}">
            <TextBlock Classes="SettingLabel" Margin="0" Text="Total tracked" />
            <TextBlock FontSize="{StaticResource FontSizeHeadline}"
                       FontWeight="SemiBold"
                       Text="{Binding TotalText}"
                       AutomationProperties.Name="Total tracked time" />
        </StackPanel>

        <!-- Grouping switch -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Classes="SettingLabel" Text="Group by:" />
            <ComboBox Grid.Column="1"
                      HorizontalAlignment="Left"
                      MinWidth="180"
                      ItemsSource="{Binding Groupings}"
                      SelectedItem="{Binding SelectedGrouping}"
                      AutomationProperties.Name="Group by">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupingOption">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!-- Content states -->
        <ScrollViewer Grid.Row="2" Classes="settings-scroll">
            <StackPanel Spacing="{StaticResource SpacingSm}">
                <TextBlock Text="Loading…"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding IsLoading}" />

                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           IsVisible="{Binding IsMessageVisible}" />

                <TextBlock Text="{Binding WarningText}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}"
                           IsVisible="{Binding HasWarning}" />

                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding IsReady}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SummaryRowViewModel">
                            <StackPanel Margin="0,0,0,8" Spacing="{StaticResource SpacingXs}">
                                <Grid ColumnDefinitions="*,Auto,56">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis"
                                               Classes.summary-unassigned="{Binding IsUnassigned}"
                                               ToolTip.Tip="{Binding EntryCountText}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DurationText}"
                                               FontFamily="{StaticResource TabularTimerFontFamily}"
                                               Margin="12,0,0,0" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ShareText}"
                                               TextAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Height="6"
                                             ShowProgressText="False"
                                             Value="{Binding SharePercent}"
                                             Foreground="{DynamicResource AccentPrimaryBrush}"
                                             Background="{DynamicResource SurfaceSubtleBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
