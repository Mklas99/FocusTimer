<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FocusTimer.App.Converters"
    xmlns:vm="using:FocusTimer.App.ViewModels"
    xmlns:views="clr-namespace:FocusTimer.App.Views"
    x:Class="FocusTimer.App.Views.TimerWidgetWindow"
    x:DataType="vm:TimerWidgetViewModel"
    Title="FocusTimer"
    WindowStartupLocation="Manual"
    SystemDecorations="None"
    ShowInTaskbar="False"
    TransparencyLevelHint="Transparent"
    CanResize="False"
    UseLayoutRounding="False"
    Background="Transparent"
    TransparencyBackgroundFallback="{DynamicResource WidgetShellFallbackBrush}"
    ExtendClientAreaToDecorationsHint="False"
    Opacity="{Binding OverallOpacity}"
    BorderBrush="Transparent"
    BorderThickness="0"
    SizeToContent="WidthAndHeight"
    Topmost="{Binding Settings.AlwaysOnTop}">

    <!-- The widget owns its outline; Fluent's window template otherwise adds a second border. -->
    <Window.Template>
        <ControlTemplate>
            <ContentPresenter Name="PART_ContentPresenter"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}" />
        </ControlTemplate>
    </Window.Template>

    <Window.Resources>
        <converters:PlayPauseConverter x:Key="PlayPauseConverter" />
        <converters:BooleanNegationConverter x:Key="BooleanNegationConverter" />
        <converters:BooleanToAngleConverter x:Key="BooleanToAngleConverter" />
    </Window.Resources>

    <Grid x:Name="WidgetRoot"
        Background="Transparent"
        ClipToBounds="False">
        <!-- Single glass surface: no nested translucent layers -->
        <Border x:Name="WidgetShell"
            Background="{DynamicResource WidgetShellActiveBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding WidgetCornerRadius}"
            IsHitTestVisible="False" />
        <Border x:Name="WidgetSurface"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        CornerRadius="{Binding WidgetCornerRadius}"
        ClipToBounds="False"
        Padding="0"
        PointerPressed="WindowDragArea_PointerPressed"
        PointerEntered="DragArea_PointerEnter"
        PointerExited="DragArea_PointerLeave"
        VerticalAlignment="Center"
        HorizontalAlignment="Center">

            <Grid x:Name="ContentLayer"
            Background="Transparent"
            ClipToBounds="False"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
                <!-- Content area: switch between full and compact modes -->
                <Grid
                Background="Transparent"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
                    <views:FullModeView
                    Margin="{Binding WidgetContentMargin}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding UseCompactMode, Converter={StaticResource BooleanNegationConverter}}" />
                    <views:CompactModeView
                    Margin="{Binding CompactContentMargin}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding UseCompactMode}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
