<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Headless Avalonia tests initialize a process-wide Application.Current, which several
      pure-logic tests in FocusTimer.App.Tests rely on staying null. Keeping these tests in a
      separate assembly (its own test process) avoids that collision; coverage from this
      project is merged with FocusTimer.App.Tests' results by scripts/run-unit-coverage.ps1.
    -->
    <PackageReference Include="Avalonia.Headless" Version="11.2.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="coverlet.msbuild" Version="6.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FocusTimer.App\FocusTimer.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\ThemeFixtures.cs" Link="ThemeFixtures.cs" />
  </ItemGroup>

</Project>
