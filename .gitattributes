# Recommended .gitattributes for FocusTimer (C#/.NET, scripts, docs)

# C# source files (force CRLF for Windows compatibility)
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.config text eol=crlf
*.resx text eol=crlf

# Shell scripts (force LF for Unix compatibility)
*.sh text eol=lf

# PowerShell scripts (force CRLF for Windows)
*.ps1 text eol=crlf

# Batch files (force CRLF)
*.bat text eol=crlf

# Markdown and documentation (use LF)
*.md text eol=lf

# JSON files (use LF)
*.json text eol=lf

# YAML files (use LF)
*.yml text eol=lf
*.yaml text eol=lf

# Third-party reproducible build inputs checked against SHA256 in provenance.json
third_party/avalonia-widget-backdrop/Win32BackdropControllerV1.cs text eol=lf
third_party/avalonia-widget-backdrop/FocusTimerBackend.csproj text eol=lf
third_party/avalonia-widget-backdrop/PublishPrototype.targets text eol=lf
third_party/avalonia-widget-backdrop/backend.patch text eol=lf whitespace=-blank-at-eol
third_party/avalonia-widget-backdrop/backend.packages.lock.json text eol=crlf
third_party/avalonia-widget-backdrop/generators.packages.lock.json text eol=crlf
third_party/avalonia-widget-backdrop/LICENSE.md text eol=crlf

# Images and binaries (never modify)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.exe binary
*.dll binary
*.pdb binary
*.wixpdb binary
*.nupkg binary

# Catch-all: auto-detect text files
* text=auto
